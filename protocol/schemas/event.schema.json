{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lpc1768-simulator.local/protocol/schemas/event.schema.json",
  "title": "WebSocket event envelope",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "type",
    "event_id",
    "session_id",
    "timestamp",
    "payload"
  ]
}
