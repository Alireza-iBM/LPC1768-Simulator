{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lpc1768-simulator.local/protocol/schemas/hardware_state.schema.json",
  "title": "LPC1768 board state",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "board": {
      "const": "LPC1768"
    },
    "peripherals": {
      "type": "array",
      "items": {
        "enum": [
          "GPIO",
          "NVIC_EXTERNAL_INTERRUPT"
        ]
      },
      "uniqueItems": true
    },
    "gpio": {
      "$ref": "gpio.schema.json"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "board",
    "peripherals",
    "gpio",
    "updated_at"
  ]
}
